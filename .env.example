# Copy to .env locally. Never commit the copy.
COMPOSE_PROJECT_NAME=minecraft-network
MC_UID=1000
MC_GID=1000
MC_VERSION=1.21.11
VELOCITY_VERSION=4.3.1
# These are reviewed immutable image references; update them only with an approved digest change.
VELOCITY_IMAGE=itzg/mc-proxy:java25@sha256:3f774514bbeb8842a9b147abd03ab3b6f1fd3f45119831f1bfdb98e159d80b24
PURPUR_IMAGE=itzg/minecraft-server:java25@sha256:7d4a888284c2f8d468f620f2534de648cb8eacba48df8d4d20b6ad1ef201f3a3
PURPUR_LOBBY_IMAGE=itzg/minecraft-server:java25@sha256:7d4a888284c2f8d468f620f2534de648cb8eacba48df8d4d20b6ad1ef201f3a3
NANOLIMBO_IMAGE=eclipse-temurin:21-jre@sha256:0b99b3376fbb50dbf9c0af8535fdd5b8eb0d3fdfc8b1e4967f383b6919f6901a
MC_MONITOR_IMAGE=itzg/mc-monitor:0.17.0@sha256:0d6b89c29d93cfcfcfee7bfd8e3758ddf00e20eb157e3e9a6560a93fe7fe84d1
POSTGRES_DB=minecraft
POSTGRES_USER=minecraft
BACKUP_DIR=/var/backups/minecraft-network
BACKUP_RETENTION=1
BACKUP_AGE_RECIPIENT_FILE=/etc/minecraft-network/backup.age-recipient
BACKUP_AGE_IDENTITY_FILE=/etc/minecraft-network/backup.age-identity
SSH_PORT=22
MC_PROXY_PORT=25565
MC_PROXY_BIND=0.0.0.0
MONITORING_BIND=127.0.0.1
GRAFANA_PORT=3000
UPTIME_KUMA_PORT=3001
TZ=Europe/Warsaw

# Discord Bot integration (optional; bot token in secrets/discord_bot_token)
DISCORD_GUILD_ID=
DISCORD_STATUS_CHANNEL_ID=
DISCORD_CHAT_CHANNEL_ID=
DISCORD_STAFF_CHANNEL_ID=
DISCORD_LINKED_ROLE_ID=
DISCORD_STAFF_ROLE_ID=


